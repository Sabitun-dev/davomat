# Copy this file to .env for local work. NEVER commit .env.
# On Netlify, set the same names under Site configuration -> Environment variables.

# Telegram bot token from @BotFather (/newbot). Secret.
BOT_TOKEN=
# Bot username without @, e.g. davomat_bot. Filled automatically by /setup if left empty.
BOT_USERNAME=
# Short name you gave the Mini App in @BotFather (/newapp), e.g. app.
MINIAPP_SHORT_NAME=app

# Random long strings (at least 32 characters). Make each one different. Secret.
# Telegram sends WEBHOOK_SECRET with every update so we know it is really Telegram.
WEBHOOK_SECRET=
# Protects the setup page: https://<your-site>/setup?key=SETUP_SECRET
SETUP_SECRET=
# Signs branch QR codes and download links. Changing it makes all printed QR codes invalid.
QR_SIGNING_SECRET=

# Neon: "Pooled connection" string (host contains -pooler). Secret.
DATABASE_URL=
# Neon: "Direct connection" string (no -pooler). Used only for migrations. Secret.
DATABASE_URL_UNPOOLED=

# The bosses' Telegram group id, e.g. -1001234567890. Send /groupid in the group to get it.
GROUP_CHAT_ID=
# Telegram user ids of the owners, separated by commas, e.g. 123456789,987654321.
OWNER_TELEGRAM_IDS=

# uz, ru or en
DEFAULT_LANGUAGE=uz
DEFAULT_TIMEZONE=Asia/Tashkent

# Optional. Public address of the site. Netlify sets URL automatically, so leave empty there.
APP_URL=
