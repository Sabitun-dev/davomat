{
  "name": "davomat",
  "version": "1.0.0",
  "description": "Davomat: Telegram Mini App for staff attendance, lateness and daily pay",
  "scripts": {
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p webapp/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build --config webapp/vite.config.ts",
    "dev": "vite --config webapp/vite.config.ts",
    "migrate": "node scripts/migrate.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "netlify-build": "npm run typecheck && npm test && npm run build && npm run migrate",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "fflate": "^0.8.3",
    "grammy": "^1.46.0",
    "hono": "^4.13.19",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.3",
    "@netlify/functions": "^6.1.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.76.0",
    "pglite-prisma-adapter": "^0.7.2",
    "prisma": "^7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
